{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "padding": {
            "top": 2,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "  ",
        "key": {
            "type": "both"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },

        {
            "type": "separator",
        },

        {
            "type": "os"
        },

        {
            "type": "host"
        },

        {
            "type": "kernel"
        },

        {
            "type": "uptime"
        },

        {
            "type": "packages"
        },

        {
            "type": "shell"
        },

        {
            "type": "display"
        },

        {
            "type": "de"
        },

        {
            "type": "wm"
        },

        {
            "type": "wmtheme"
        },

        {
            "type": "theme"
        },

        {
            "type": "icons"
        },

        {
            "type": "font"
        },

        {
            "type": "cursor"
        },

        {
            "type": "terminal"
        },

        {
            "type": "terminalfont"
        },

        {
            "type": "separator",
        },

        {
            "type": "cpu"
        },

        {
            "type": "gpu"
        },

        {
            "type": "memory"
        },

        {
            "type": "swap"
        },

        {
            "type": "disk"
        },

        {
            "type": "localip"
        },

        {
            "type": "battery"
        },

        {
            "type": "poweradapter"
        },

        {
            "type": "locale"
        },

        {
            "type": "separator",
        },

        {
            "type": "custom",
            "format": " {#30}● {#31}● {#32}● {#33}● {#34}● {#35}● {#36}● {#37}●{#}"
        },

        {
            "type": "custom",
            "format": " {#90}● {#91}● {#92}● {#93}● {#94}● {#95}● {#96}● {#97}●{#}"
        }
    ]
}
