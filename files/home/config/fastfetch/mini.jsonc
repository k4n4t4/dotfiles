{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",

        "padding": {
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "  ",
        "key": {
            "type": "icon"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": " {user-name-colored}{at-symbol-colored}{host-name-colored}"
        },

        {
            "type": "memory",
        },

        {
            "type": "swap",
        },

        {
            "type": "disk",
        },

        {
            "type": "battery",
        },

        {
            "type": "custom",
            "format": " {#30}● {#31}● {#32}● {#33}● {#34}● {#35}● {#36}● {#37}●{#}"
        },

        {
            "type": "custom",
            "format": " {#90}● {#91}● {#92}● {#93}● {#94}● {#95}● {#96}● {#97}●{#}"
        }
    ]
}
